@include ../CubeOrangePlus/defaults.parm

AHRS_EKF_TYPE 3 @READONLY

EK3_PRIMARY 1

#Setup RFD-900X on Telem1 -> Serial1
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57
SERIAL1_OPTIONS 0

#Setup HDZero Freestyle VTX V2 on Telem2 -> Serial2
VTX_ENABLE 1
SERIAL2_PROTOCOL 42
SERIAL2_BAUD 115
MSP_OPTIONS 5
OSD_TYPE 5

#Setup GPS on GPS1 -> Serial3 - A bug seems to exist and this must stay as GPS. I have not been able to run any other protocol other than GPS on Serial3.
SERIAL3_PROTOCOL 5

#Setup Remote ID on GPS2 -> Serial4
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 57
DID_ENABLE 1
DID_CANDRIVER 0
DID_MAVPORT 4

#Setup TF02-PRO RangeFinder on I2C
RNGFND1_ADDR 16 @READONLY
RNGFND1_GNDCLEAR 10
RNGFND1_MIN_CM 10
RNGFND1_MAX_CM 4000
RNGFND1_ORIENT 25
RNGFND1_TYPE 25




