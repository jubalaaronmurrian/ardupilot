@include ../CubeOrangePlus/defaults.parm

AHRS_EKF_TYPE 3 @READONLY

EK3_PRIMARY 1

#Setup RFD-900X on Telem1 -> Serial1
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57
SERIAL1_OPTIONS 0

#Setup HDZero Freestyle VTX V2 on Telem2 -> Serial2
VTX_ENABLE 1
SERIAL2_PROTOCOL 42
SERIAL2_BAUD 115
MSP_OPTIONS 5
OSD_TYPE 5

#Setup GPS on GPS1 -> Serial3 - A bug seems to exist and this must stay as GPS. I have not been able to run any other protocol other than GPS on Serial3.
SERIAL3_PROTOCOL 5

#Setup Remote ID on GPS2 -> Serial4
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 57
DID_ENABLE 1
DID_CANDRIVER 0
DID_MAVPORT 4

#Setup TF02-PRO RangeFinder on I2C - 0x10 - 20
RNGFND1_ADDR 16 
RNGFND1_GNDCLEAR 10
RNGFND1_MIN_CM 10
RNGFND1_MAX_CM 4000
RNGFND1_ORIENT 25
RNGFND1_TYPE 25

#Setup TF-Luna RangeFinder on I2C - 0x11 - 22
RNGFND2_ADDR 17 
RNGFND2_GNDCLEAR 10
RNGFND2_MIN_CM 20
RNGFND2_MAX_CM 800
RNGFND2_ORIENT 0
RNGFND2_TYPE 25

#TakeoffAndLanding
#https://ardupilot.org/copter/docs/common-understanding-altitude.html
#https://ardupilot.org/plane/docs/parameters.html#rngfnd-landing
RNGFND_LANDING 1

#RTL
#https://ardupilot.org/copter/docs/rtl-mode.html
#https://ardupilot.org/copter/docs/smartrtl-mode.html
RTL_ALT 1.5
RTL_ALT_FINAL 1.5
RTL_LOIT_TIME 5
WP_YAW_BEHAVIOR 1

#Land the Drone
#https://ardupilot.org/plane/docs/parameters.html#batt-fs-low-act-low-battery-failsafe-action
BATT_FS_LOW_ACT 1
#https://ardupilot.org/plane/docs/parameters.html#batt-crt-volt-critical-battery-voltage
BATT_FS_CRT_ACT 2

#Obstacle Avoidance
#https://ardupilot.org/copter/docs/common-simple-object-avoidance.html
AVOID_ALT_MIN 2.5

#Battery failsafe
#https://ardupilot.org/copter/docs/failsafe-battery.html
BATT_LOW_VOLT 14.0
BATT_CRT_VOLT 13.2
BATT_LOW_MAH 4000
BATT_FS_VOLTSRC 1

#Fences
#https://ardupilot.org/copter/docs/common-geofencing-landing-page.html
FENCE_ENABLE 1
FENCE_ACTION 1
FENCE_MARGIN 20
FENCE_RADIUS 30
FENCE_ALT_MAX 121.92
FENCE_TYPE 1



