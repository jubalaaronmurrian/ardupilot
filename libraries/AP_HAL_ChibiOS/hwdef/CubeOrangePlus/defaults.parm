# setup correct defaults for battery monitoring for cube power brick
#https://ardupilot.org/plane/docs/common-3dr-power-module.html

BATT_MONITOR 4
BATT_CURR_PIN 15
BATT_VOLT_PIN 14
BATT_AMP_PERVLT 39.877
BATT_VOLT_MULT 12.02

BATT2_MONITOR 0
BATT2_CURR_PIN 4
BATT2_VOLT_PIN 13
BATT2_AMP_PERVLT 39.877
BATT2_VOLT_MULT 12.02

#Setup ADSB on Serial5
ADSB_TYPE 1
SERIAL5_BAUD 57
SERIAL5_PROTOCOL 1






